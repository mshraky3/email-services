# ── Database ────────────────────────────────────────────────────────────────
# Neon pooled connection string. Use the -pooler host: serverless functions open
# a new connection per invocation and will exhaust a direct Postgres endpoint.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/emaildb?sslmode=require

# ── Resend (the gateway holds the ONLY copy of this key) ─────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_DOMAIN=smle-question-bank.com

# ── Gmail SMTP (owner-facing mail — costs ZERO Resend quota) ─────────────────
# A Gmail App Password, not the account password. 500 sends/day, separate quota.
GMAIL_SMTP_USER=youraccount@gmail.com
GMAIL_SMTP_PASS=xxxxxxxxxxxxxxxx
GMAIL_FROM_ADDRESS=youraccount@gmail.com

# ── Secrets ─────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me-long-random
DRAIN_SECRET=change-me-long-random
UNSUB_SECRET=change-me-long-random
# Accept unsubscribe tokens minted by MEDQIZE's existing /api/unsubscribe so
# links already sitting in real inboxes keep working. Set to SQB's ADMIN_KEY.
LEGACY_UNSUB_SECRET=

# ── Safety ──────────────────────────────────────────────────────────────────
# TRUE  = nothing is actually sent; every send is recorded as it would have been.
# Keep TRUE until the gateway has been observed for a full shadow week.
DRY_RUN=true

# Production hostnames. A send whose source_origin is not one of these is
# DROPPED (no email, no quota) — this is what kills the "localhost frontend
# pointed at prod backend" error spam. Comma-separated, no scheme.
PRODUCTION_ORIGINS=smle-question-bank.com,www.smle-question-bank.com,medquiz.vercel.app,medquiz-web.vercel.app,hr-react-theta.vercel.app,alshraky.com,www.alshraky.com

# Public base URL of this gateway (used to build unsubscribe links).
PUBLIC_BASE_URL=https://email-system.vercel.app
