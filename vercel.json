{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/v1/drain",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/api/v1/drain/route.ts": { "maxDuration": 60 },
    "app/api/v1/send/route.ts": { "maxDuration": 30 },
    "app/api/v1/send/bulk/route.ts": { "maxDuration": 60 }
  }
}
